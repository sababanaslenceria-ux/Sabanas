#Carta CUSUMSQ
cusumsq <- function(model,
                    main = "CUSUM of Squares",
                    alpha = 0.05) {
  
  if (!requireNamespace("strucchange", quietly = TRUE))
    stop("Package 'strucchange' is required")
  
  # Recursive residuals
  w <- strucchange::recresid(model)
  
  # CUSUMSQ process
  S <- cumsum(w^2) / sum(w^2)
  
  n <- length(S)
  t <- seq_len(n) / n
  
  # Approximate 95% confidence bands
  # Based on Brownian bridge approximation
  k <- 0.948   # approximately 5% level
  
  lower <- t - k * sqrt(t * (1 - t))
  upper <- t + k * sqrt(t * (1 - t))
  
  lower <- pmax(lower, 0)
  upper <- pmin(upper, 1)
  
  plot(t, S,
       type = "l",
       lwd = 2,
       ylim = c(0, 1),
       xlab = "Fraction of sample",
       ylab = "CUSUMSQ",
       main = main,
       col="red")
  
  lines(t, lower, lty = 2)
  lines(t, upper, lty = 2)
  
  abline(h = c(0,1), col = "grey80")
  
  out <- list(
    process = S,
    lower = lower,
    upper = upper,
    crossing = any(S < lower | S > upper)
  )
  
  invisible(out)
}

