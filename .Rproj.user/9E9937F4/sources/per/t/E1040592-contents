# ==========================================================
# 9. Diebold Mariano y encompassing
# ==========================================================

# Pronóstico ventana expansible (rolling origin) sin recalibración
n0 <- 50
h <- 1

train0 <- window(
  serie_est,
  end = time(serie_est)[n0]
)

# Ajuste inicial único
modelo_arima0 <- auto.arima(train0)

modelo_ets0 <- ets(train0)

e_arima <- c()
e_ets <- c()

#==================================================
# Rolling origin sin recalibración
#==================================================

for(i in n0:(length(serie_est)-h))
{
  
  train <- window(
    serie_est,
    end = time(serie_est)[i]
  )
  
  test <- serie_est[i+h]
  
  # Actualización sin reestimar parámetros
  fitA <- Arima(
    train,
    model = modelo_arima0
  )
  
  fitE <- ets(
    train,
    model = modelo_ets0,
    use.initial.values = TRUE
  )
  
  predA <- forecast(fitA,h=1)$mean
  predE <- forecast(fitE,h=1)$mean
  
  e_arima <- c(e_arima, test - predA)
  e_ets   <- c(e_ets, test - predE)
}

#Diebold-Mariano
dm.test(
  e_arima,
  e_ets,
  alternative="two.sided",
  h=1,
  power=2
)

dm.test(
  e_arima,
  e_ets,
  alternative="less",
  h=1,
  power=2
) #Menores pérdidas cuadráticas promedio en modelo ARIMA

#Encompassing
actual <- serie_est[(50+h):length(serie_est)]

pred_arima <- actual - e_arima
pred_ets   <- actual - e_ets

modelo_enc <- lm(
  actual ~ pred_arima + pred_ets
)

summary(modelo_enc)

linearHypothesis(
  modelo_enc,
  "pred_ets = 0"
)

linearHypothesis(
  modelo_enc,
  "pred_arima = 0"
)


