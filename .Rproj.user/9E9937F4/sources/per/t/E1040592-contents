#Test de Box Pierce
plot_box_test <- function(x,
                          lag.max = 30,
                          fitdf = 0,
                          type = c("Ljung-Box", "Box-Pierce"),
                          alpha = 0.05,
                          pch = 19) {
  
  type <- match.arg(type)
  
  pvals <- sapply(seq_len(lag.max), function(k) {
    
    # Skip lags that are not valid after df adjustment
    if (k <= fitdf) return(NA)
    
    Box.test(
      x,
      lag = k,
      type = type,
      fitdf = fitdf
    )$p.value
  })
  
  plot(
    seq_len(lag.max),
    pvals,
    type = "b",
    pch = pch,
    ylim = c(0, 1),
    xlab = "Lag",
    ylab = "p-value",
    main = paste(type, "Test Across Lags")
  )
  
  abline(h = alpha, lty = 2, col = "red")
  
  legend(
    "topright",
    legend = paste0("α = ", alpha),
    lty = 2,
    col = "red",
    bty = "n"
  )
  
  invisible(
    data.frame(
      lag = seq_len(lag.max),
      p.value = pvals
    )
  )
}

